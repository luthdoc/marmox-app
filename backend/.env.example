# =============================================================================
# Marmax Backend — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA commite o arquivo .env no repositório.
# =============================================================================

# --- Supabase ---
# URL do projeto Supabase (ex: https://xyzxyz.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Chave de serviço do Supabase (service role key — acesso irrestrito ao banco)
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# --- Anthropic ---
# Chave da API Anthropic para acesso ao Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# --- Meta WhatsApp Cloud API ---
# Token de acesso permanente gerado no Meta for Developers (System User token)
META_WHATSAPP_ACCESS_TOKEN=EAABs...

# Token de verificação do webhook (string arbitrária que você define e configura no Meta)
META_WHATSAPP_VERIFY_TOKEN=marmax-webhook-2026

# --- Aplicação (opcionais) ---
# Ambiente de execução: development | production (padrão: development)
APP_ENV=development

# Nível de log: DEBUG | INFO | WARNING | ERROR | CRITICAL (padrão: INFO)
LOG_LEVEL=INFO
